# Canonical public origin. Without it the build is a noindex preview.
WEMUTE_SITE_URL=https://wemute.entropinia.com

# Shown on the privacy, terms and about pages.
PUBLIC_CONTACT_EMAIL=

# Cookieless Vercel Web Analytics (enable it in the Vercel project first).
PUBLIC_VERCEL_ANALYTICS=false

# Optional Google Analytics 4. Loads only after a visitor opts in.
PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense. Leave disabled until the site is approved and the
# AdSense "Privacy & messaging" consent message is published for EEA/UK/CH.
PUBLIC_ADSENSE_ENABLED=false
PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
PUBLIC_ADSENSE_SLOT_CONTENT=
PUBLIC_ADSENSE_SLOT_FOOTER=
# Writes /ads.txt. Must match the client ID without the "ca-" prefix.
ADSENSE_PUBLISHER_ID=pub-0000000000000000
