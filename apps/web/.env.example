# A production build is intentionally noindex until this is an HTTPS origin you own.
WEMUTE_SITE_URL=https://example.com
VITE_SITE_URL=https://example.com

# Optional, privacy-first analytics. The tag loads only after the visitor opts in.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional advertising. Enable only after AdSense approval and a Google-certified CMP is active.
VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
VITE_ADSENSE_HOME_SLOT=0000000000
VITE_ADSENSE_TOOL_SLOT=0000000000
VITE_ADSENSE_CONSENT_READY=false

# Used to generate ads.txt. It must match VITE_ADSENSE_CLIENT without the "ca-" prefix.
ADSENSE_PUBLISHER_ID=pub-0000000000000000
