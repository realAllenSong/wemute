---
import Icon from "./Icon.astro";
import { localePath, type Locale } from "../data/locale";
import { CATEGORY_LABEL, CATEGORY_ORDER, toolsIn } from "../data/tools";
import { ui } from "../data/ui";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const strings = ui(locale);
const other: Locale = locale === "en" ? "zh" : "en";
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={localePath(locale)} aria-label="Wemute">
      <img src="/icon-192.png" alt="" width="26" height="26" />
      <span>Wemute</span>
    </a>
    <nav class="nav" aria-label={strings.allTools}>
      {
        CATEGORY_ORDER.map((category) => (
          <details class="nav__menu">
            <summary>
              {CATEGORY_LABEL[category][locale]}
              <Icon name="chevron-down" size={14} />
            </summary>
            <div class="nav__panel">
              {toolsIn(category).map((tool) => (
                <a href={localePath(locale, tool.slug)} aria-current={tool.slug === slug ? "page" : undefined}>
                  {tool.name[locale]}
                </a>
              ))}
            </div>
          </details>
        ))
      }
    </nav>
    <a class="lang" href={localePath(other, slug)} hreflang={other === "zh" ? "zh-CN" : "en"} lang={other === "zh" ? "zh-CN" : "en"} aria-label={strings.languageLabel}>
      <Icon name="globe" size={15} />
      <span>{strings.language}</span>
    </a>
  </div>
</header>

<script>
  // Close other menus when one opens, and on outside click or Escape.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>(".nav__menu"));
  for (const menu of menus) {
    menu.addEventListener("toggle", () => {
      if (menu.open) for (const other of menus) if (other !== menu) other.open = false;
    });
  }
  document.addEventListener("click", (event) => {
    if (!(event.target as Element).closest(".nav__menu")) for (const menu of menus) menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") for (const menu of menus) menu.open = false;
  });
</script>
