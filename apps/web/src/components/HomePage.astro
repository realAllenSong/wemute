---
import Base from "../layouts/Base.astro";
import AdSlot from "./AdSlot.astro";
import Faq from "./Faq.astro";
import MacPromo from "./MacPromo.astro";
import Converter from "./converter/Converter.tsx";
import { localePath, type Locale } from "../data/locale";
import { buildPicker } from "../data/picker";
import { TOOLS, toolsIn, type Tool } from "../data/tools";
import { HOME } from "../data/site";
import { ui } from "../data/ui";
import { faqPage, graph, organization, website } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = ui(locale);
const site = Astro.site!;
const jsonLd = graph(organization(site), website(site, locale, HOME.metaDescription[locale]), faqPage(HOME.faqs, locale));
const picker = buildPicker(TOOLS, locale);

// The most used tools, a few from each kind; the sidebar lists all of them.
const popular: Tool[] = [
  ...HOME.popularImage.slice(0, 4).map((slug) => toolsIn("image").find((tool) => tool.slug === slug)!),
  ...toolsIn("video").slice(0, 3),
  ...toolsIn("audio").slice(0, 2),
].filter(Boolean);
---

<Base locale={locale} slug="" title={HOME.metaTitle[locale]} description={HOME.metaDescription[locale]} jsonLd={jsonLd}>
  <main class="page">
    <div class="topline">
      <div>
        <p class="eyebrow"><i aria-hidden="true"></i>{HOME.eyebrow[locale]}</p>
        <h1>{HOME.h1[locale]}</h1>
        <p class="answer">{HOME.intro[locale]}</p>
      </div>
      <ul class="badges">
        <li>{strings.trustLocal}</li>
        <li>{strings.trustNoSignup}</li>
        <li>{strings.trustBatch}</li>
      </ul>
    </div>

    <div id="converter" class="work converter-shell">
      <Converter client:load locale={locale} strings={strings} picker={picker} />
    </div>

    <div class="below">
      <div class="below__main">
        <section class="panel" aria-labelledby="why">
          <p class="kicker">{HOME.whyKicker[locale]}</p>
          <h2 id="why">{HOME.whyTitle[locale]}</h2>
          <div class="facts">
            {
              HOME.why.map((item, index) => (
                <div class="fact">
                  <p class="fact__n">
                    {index === 1 ? item.figure : <em>{item.figure}</em>}
                    {item.unit[locale] && ` ${item.unit[locale]}`}
                  </p>
                  <h3>{item.title[locale]}</h3>
                  <p>{item.body[locale]}</p>
                </div>
              ))
            }
          </div>
        </section>

        <Faq kicker={strings.faq} title={strings.faqTitle} faqs={HOME.faqs} locale={locale} />
      </div>

      <div class="below__side">
        <section class="panel" aria-labelledby="popular">
          <h2 id="popular">{HOME.toolsTitle[locale]}</h2>
          <div class="related">
            {popular.map((tool) => <a href={localePath(locale, tool.slug)}>{tool.name[locale]}</a>)}
          </div>
        </section>
        <AdSlot locale={locale} placement="content" />
        <MacPromo locale={locale} />
      </div>
    </div>
  </main>
</Base>
