---
import Base from "../layouts/Base.astro";
import AdSlot from "./AdSlot.astro";
import Faq from "./Faq.astro";
import Converter from "./converter/Converter.tsx";
import { localePath, type Locale } from "../data/locale";
import { buildPicker } from "../data/picker";
import { CATEGORY_LABEL, TOOLS, TOOL_BY_SLUG, type Tool } from "../data/tools";
import { COMPARISON_ROWS, FORMATS } from "../data/formats";
import { format, ui } from "../data/ui";
import { breadcrumbs, faqPage, graph, howTo, organization, toolApplication } from "../lib/site";

interface Props {
  locale: Locale;
  tool: Tool;
}

const { locale, tool } = Astro.props;
const strings = ui(locale);
const site = Astro.site!;
const home = localePath(locale);
const categoryAnchor = `${home === "/" ? "" : home}/#${tool.category}`;
const crumbs = [
  { name: strings.breadcrumbHome, path: home },
  { name: CATEGORY_LABEL[tool.category][locale], path: categoryAnchor },
  { name: tool.name[locale], path: localePath(locale, tool.slug) },
];
const jsonLd = graph(
  organization(site),
  toolApplication(site, tool, locale),
  howTo(tool, locale),
  faqPage(tool.faqs, locale),
  breadcrumbs(site, crumbs),
);
const source = tool.from[0] ? FORMATS[tool.from[0]] : undefined;
const target = tool.to ? FORMATS[tool.to] : undefined;
const related = tool.related.map((slug) => TOOL_BY_SLUG.get(slug)).filter((item): item is Tool => Boolean(item));
const converterTool = {
  slug: tool.slug,
  category: tool.category,
  mode: tool.mode,
  accept: tool.accept,
  output: tool.output,
  outputs: tool.outputs,
  preset: tool.preset,
};
const picker = buildPicker(TOOLS, locale);
---

<Base locale={locale} slug={tool.slug} title={tool.metaTitle[locale]} description={tool.metaDescription[locale]} jsonLd={jsonLd}>
  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      {
        crumbs.map((crumb, index) =>
          index < crumbs.length - 1 ? (
            <>
              <a href={crumb.path}>{crumb.name}</a>
              <span aria-hidden="true">›</span>
            </>
          ) : (
            <span aria-current="page">{crumb.name}</span>
          ),
        )
      }
    </nav>

    <section class="hero hero--tool">
      <h1>{tool.h1[locale]}</h1>
      <p class="answer">{tool.answer[locale]}</p>
    </section>

    <div id="converter" class="converter-shell">
      <Converter client:load locale={locale} strings={strings} picker={picker} tool={converterTool} />
    </div>
    <ul class="trust">
      <li>{strings.trustNoUpload}</li>
      <li>{strings.trustNoSignup}</li>
      <li>{strings.trustZip}</li>
    </ul>

    <section class="block" aria-labelledby="how">
      <p class="kicker">{strings.howItWorks}</p>
      <h2 id="how">{strings.stepsTitle}</h2>
      <ol class="steps">
        {
          tool.steps.map((step, index) => (
            <li>
              <span class="steps__n" aria-hidden="true">{index + 1}</span>
              <p>{step[locale]}</p>
            </li>
          ))
        }
      </ol>
      <div class="uses">
        <h3>{strings.goodFor}</h3>
        <ul>
          {tool.useCases.map((item) => <li>{item[locale]}</li>)}
        </ul>
      </div>
    </section>

    <AdSlot locale={locale} placement="content" />

    {
      source && target && (
        <section class="block" aria-labelledby="compare">
          <p class="kicker">{strings.compare}</p>
          <h2 id="compare">{format(strings.compareTitle, { a: source.name, b: target.name })}</h2>
          <div class="compare">
            <table>
              <thead>
                <tr>
                  <td />
                  <th scope="col">{source.name}</th>
                  <th scope="col">{target.name}</th>
                </tr>
              </thead>
              <tbody>
                {COMPARISON_ROWS.filter((row) => source[row.key] && target[row.key]).map((row) => (
                  <tr>
                    <th scope="row">{row.label[locale]}</th>
                    <td>{(source[row.key] as Record<Locale, string>)[locale]}</td>
                    <td>{(target[row.key] as Record<Locale, string>)[locale]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="compare__notes">
            <strong>{source.name}:</strong> {source.note[locale]} <strong>{target.name}:</strong> {target.note[locale]}
          </p>
        </section>
      )
    }

    <Faq kicker={strings.faq} title={format(strings.faqAbout, { name: tool.name[locale] })} faqs={tool.faqs} locale={locale} />

    <section class="block" aria-labelledby="related">
      <h2 id="related" class="kicker">{strings.relatedTools}</h2>
      <div class="related">
        {related.map((item) => <a href={localePath(locale, item.slug)}>{item.name[locale]}</a>)}
      </div>
    </section>

    <AdSlot locale={locale} placement="footer" />
  </main>
</Base>
