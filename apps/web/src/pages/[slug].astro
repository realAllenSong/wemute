---
import ToolPage from "../components/ToolPage.astro";
import LegalPage from "../components/LegalPage.astro";
import MacPage from "../components/MacPage.astro";
import { MAC_PAGES, MAC_PAGE_BY_SLUG, type MacSlug } from "../data/mac-pages";
import { TOOLS, TOOL_BY_SLUG } from "../data/tools";
import { LEGAL, LEGAL_BY_SLUG } from "../data/site";

export function getStaticPaths() {
  return [...TOOLS.map((tool) => tool.slug), ...LEGAL.map((page) => page.slug), ...MAC_PAGES.map((page) => page.slug)].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const tool = TOOL_BY_SLUG.get(slug!);
const page = LEGAL_BY_SLUG.get(slug as "privacy");
const mac = MAC_PAGE_BY_SLUG.get(slug as MacSlug);
---

{tool ? <ToolPage locale="en" tool={tool} /> : page ? <LegalPage locale="en" page={page} /> : mac && <MacPage locale="en" page={mac} />}
